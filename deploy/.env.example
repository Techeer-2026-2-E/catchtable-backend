# deploy/.env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
DB_NAME=catchtable
DB_USERNAME=catchtable
DB_PASSWORD=change-me-strong-password

# Toss API 개별 연동 시크릿 키(test_sk_...). 비우면 결제 승인·재확인이 동작하지 않는다.
TOSS_SECRET_KEY=

# 선택
# APP_PORT=80
# LOG_LEVEL=INFO
# 예약 가능 조회 캐시(최대 2초 전 값). 팀에서 허용하면 켠다.
# AVAILABILITY_CACHE_ENABLED=true
# 메모리 2GB 장비에서는 힙을 줄인다. 이 경우 개점 성능 측정값은 기대하지 않는다.
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError
