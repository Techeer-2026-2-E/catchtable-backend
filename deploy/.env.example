# deploy/.env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
DB_NAME=catchtable
DB_USERNAME=catchtable
DB_PASSWORD=change-me-strong-password

# Toss API 개별 연동 시크릿 키(test_sk_...). 비우면 결제 승인·재확인이 동작하지 않는다.
TOSS_SECRET_KEY=

