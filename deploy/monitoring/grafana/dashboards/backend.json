{
  "uid": "catchtable-backend",
  "title": "CatchTable 백엔드 시스템 지표",
  "tags": [
    "catchtable"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM 프로세스 CPU 사용률",
      "description": "앱 JVM 프로세스가 사용할 수 있는 CPU 용량 중 사용한 비율입니다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * process_cpu_usage{job=\"catchtable-backend\"}",
          "legendFormat": "JVM 프로세스 CPU 사용률",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM 힙 사용량",
      "description": "앱 JVM의 힙 메모리 풀 사용량 합계입니다.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"catchtable-backend\",area=\"heap\"})",
          "legendFormat": "JVM 힙 사용량",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC 정지 시간 · 최근 5분",
      "description": "5분 동안 GC가 애플리케이션 실행을 멈춘 시간의 추정 합계입니다. 첫 GC가 발생하기 전에는 값이 없을 수 있습니다.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jvm_gc_pause_seconds_sum{job=\"catchtable-backend\"}[5m]))",
          "legendFormat": "GC 정지 시간 · 최근 5분",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 플랫폼 스레드 수",
      "description": "ThreadMXBean이 집계한 살아 있는 플랫폼 스레드 수입니다. Java 21 가상 스레드는 이 값에 포함되지 않습니다.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads{job=\"catchtable-backend\"}",
          "legendFormat": "JVM 플랫폼 스레드 수",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB 커넥션 풀 사용률",
      "description": "앱의 HikariCP 최대 연결 수 대비 현재 대여 중인 연결 수입니다.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(hikaricp_connections_active{job=\"catchtable-backend\"}) / sum(hikaricp_connections_max{job=\"catchtable-backend\"})",
          "legendFormat": "DB 커넥션 풀 사용률",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 연결 대기",
      "description": "HikariCP에서 DB 연결을 빌리려고 기다리는 스레드 수입니다.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_pending{job=\"catchtable-backend\"})",
          "legendFormat": "DB 연결 대기",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API 요청량",
      "description": "SSE 구독을 제외한 API의 초당 완료 요청 수입니다.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"catchtable-backend\",uri=~\"/api/.*\",uri!~\".*/subscribe\"}[$__rate_interval]))",
          "legendFormat": "API 요청량",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API 응답시간 p95",
      "description": "SSE 구독을 제외한 완료 요청의 95%가 이 시간 이내에 끝났습니다. 히스토그램에서 추정하며 요청이 없으면 값이 없습니다.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"catchtable-backend\",uri=~\"/api/.*\",uri!~\".*/subscribe\"}[$__rate_interval])))",
          "legendFormat": "API 응답시간 p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API 서버 오류율",
      "description": "완료된 API 요청 중 HTTP 5xx 비율입니다. 요청이 없으면 값을 표시하지 않습니다.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"catchtable-backend\",uri=~\"/api/.*\",uri!~\".*/subscribe\",status=~\"5..\"}[$__rate_interval]))) or (0 * sum(rate(http_server_requests_seconds_count{job=\"catchtable-backend\",uri=~\"/api/.*\",uri!~\".*/subscribe\"}[$__rate_interval])))) / sum(rate(http_server_requests_seconds_count{job=\"catchtable-backend\",uri=~\"/api/.*\",uri!~\".*/subscribe\"}[$__rate_interval]))",
          "legendFormat": "API 서버 오류율",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "백엔드 지표 수집 상태",
      "description": "1이면 최근 수집에 성공했습니다. 앱과 DB의 기능 상태는 별도 health 응답에서 확인합니다.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "catchtable-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"catchtable-backend\"})",
          "legendFormat": "백엔드 지표 수집 상태",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
