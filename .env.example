# 이 파일을 .env 로 복사해서 필요한 값만 바꿔 쓰세요. (.env 는 커밋되지 않습니다)
# 기본값 그대로 쓸 거면 .env 없이도 동작합니다.

# 5433 포트가 이미 사용 중일 때만 변경
# DB_PORT=5434

# 8080 포트가 이미 사용 중일 때만 변경
# SERVER_PORT=8081

# DB_HOST=localhost
# DB_NAME=catchtable
# DB_USERNAME=catchtable
# DB_PASSWORD=catchtable

# Toss Payments 테스트 결제: 인증에 사용한 클라이언트 키와 짝인 테스트 시크릿 키를 설정한다.
# 시크릿 키는 서버 전용이다. 실제 값은 이 예시 파일이나 Git에 저장하지 않는다.
# TOSS_SECRET_KEY=
# TOSS_BASE_URL=https://api.tosspayments.com
